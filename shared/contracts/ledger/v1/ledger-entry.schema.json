{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenmarket.local/contracts/ledger/v1/ledger-entry.schema.json",
  "schema_version": "1.1.0",
  "title": "LedgerEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "account_id",
    "request_id",
    "amount_minor_units",
    "direction",
    "status",
    "rate_version",
    "created_at"
  ],
  "properties": {
    "entry_id": { "type": "string", "minLength": 1 },
    "journal_id": { "type": "string" },
    "account_id": { "type": "string", "minLength": 1 },
    "account_kind": {
      "enum": [
        "buyer_quota",
        "project_quota",
        "key_quota",
        "seller_earning",
        "platform_spread"
      ]
    },
    "request_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "key_id": { "type": "string" },
    "amount_minor_units": { "type": "integer", "minimum": 0 },
    "unit": { "type": "string", "const": "test_quota" },
    "direction": { "enum": ["debit", "credit"] },
    "status": {
      "enum": ["reserved", "settled", "released", "unresolved", "reversed"]
    },
    "rate_version": { "type": "string", "minLength": 1 },
    "evidence_digest": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "reverses_entry_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "description": "仅追加。禁止改删已发布分录。冲正通过 reverses_entry_id 指向原分录。测试额度不可购买、不可转让、不可兑换、不可提现，且无法币锚定。"
}
