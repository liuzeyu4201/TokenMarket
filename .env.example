# TokenMarket local development environment template (SF01, extended for SF02).
# Copy this file to `.env.local` and replace every placeholder with values
# generated on your workstation. Never commit real credentials; `.env.local`
# is ignored by git (see .gitignore).

# ---------------------------------------------------------------------------
# SF02 local dependency lifecycle fields (`make dev` / `make dev-down`)
#
# The three URLs below are the ONLY host/port facts for the local PostgreSQL,
# Redis, and Grafana dependencies: there are no separate POSTGRES_PORT,
# REDIS_PORT, or GRAFANA_PORT variables, and a host port is changed only by
# editing its URL. Hosts must be the IPv4 loopback literal 127.0.0.1 (never
# localhost, 0.0.0.0, a LAN address, or a remote host), and the three ports
# must be pairwise distinct (1-65535). Shell environment variables never
# override these fields; `.env.local` is their only source.
#
# Every password is a local-only synthetic secret matching
# ^tm_local_[A-Za-z0-9_-]{32,96}$ (the `tm_local_` prefix plus 32-96 URL-safe
# characters). Generate each one independently, for example:
#   python3 -c 'import secrets; print("tm_local_" + secrets.token_urlsafe(24))'
# The placeholders below are unusable by design and fail closed.

# Operational mode (classification: public local metadata). The SF02 lifecycle
# accepts exactly `local`; any other value fails with INVALID_MODE before
# configuration, Docker, socket, or lock state is touched.
MODE=local

# PostgreSQL connection (classification: secret; local-only synthetic intent).
# Grammar: postgresql://<user>:<password>@127.0.0.1:<port>/<database> with
# non-empty user/password/database and no query/fragment; the password may be
# percent-encoded only when it decodes to the tm_local_ grammar. Default port
# 5432. Also used by api-service and billing-service for local development and
# migration integration checks.
DATABASE_URL=postgresql://app:replace-me-with-a-generated-tm-local-secret@127.0.0.1:5432/tokenmarket

# Redis connection (classification: secret; local-only synthetic intent).
# Grammar: redis://default:<password>@127.0.0.1:<port>/<db-number> with the
# fixed user `default`, a tm_local_ password, a non-negative integer database
# number, and no query/fragment. Default port 6379.
REDIS_URL=redis://default:replace-me-with-a-generated-tm-local-secret@127.0.0.1:6379/0

# Grafana connection (classification: internal endpoint metadata; carries no
# user-info or credential). Grammar: http://127.0.0.1:<port> with an empty or
# root path only and no query/fragment. Default port 3000.
GRAFANA_URL=http://127.0.0.1:3000

# Grafana administrator password (classification: secret; local-only synthetic
# intent). Must match ^tm_local_[A-Za-z0-9_-]{32,96}$ and be generated
# independently of the two URL passwords; the administrator username is the
# fixed non-secret constant `admin`.
GRAFANA_ADMIN_PASSWORD=replace-me-with-a-generated-tm-local-secret

# ---------------------------------------------------------------------------
# SF01 service fields (unchanged reserved placeholders)

# Admin service does not own migrations in SF01; this URL is reserved for
# future read-only use and must remain empty or use the same safe placeholder.
ADMIN_DATABASE_URL=postgresql://app:replace-me@localhost:5432/tokenmarket

# Kafka is outside the SF02 lifecycle dependency set; reserved placeholder.
KAFKA_BROKERS=localhost:9092

# AI provider endpoints and keys are out of scope for SF01/SF02; keep placeholders.
AI_GATEWAY_URL=https://api.example.local
AI_GATEWAY_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# ADR 003 deploy stack (test/prod hosts only) — NOT used by `make dev`
#
# Copy relevant keys into ignored `.env.test` or `.env.prod` when the deploy
# adapter is implemented. Placeholders below are unusable. Never use these
# files for local process development; local middleware uses `.env.local` above.
# `make deploy mode=local` is forbidden. Image tags default to make-build output.

# MODE=test
# DATABASE_URL=postgresql://app:replace-me@127.0.0.1:5432/tokenmarket
# REDIS_URL=redis://default:replace-me@127.0.0.1:6379/0
# GRAFANA_URL=http://127.0.0.1:3000
# GRAFANA_ADMIN_PASSWORD=replace-me
# IMAGE_PROXY_GATEWAY=tokenmarket/proxy-gateway:0.1.0
# IMAGE_API_SERVICE=tokenmarket/api-service:0.1.0
# IMAGE_BILLING_SERVICE=tokenmarket/billing-service:0.1.0
# IMAGE_ADMIN_SERVICE=tokenmarket/admin-service:0.1.0
# IMAGE_FRONTEND=tokenmarket/frontend:0.1.0
