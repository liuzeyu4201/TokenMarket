  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(proxy_requests_total[1m]))",
          "legendFormat": "qps"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "noValue": "No data / scrape failed" }
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(proxy_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "noValue": "No data / scrape failed" }
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "4xx client error ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(proxy_requests_total{result=~\"client_error|auth_error\"}[5m])) / clamp_min(sum(rate(proxy_requests_total[5m])), 1e-9)",
          "legendFormat": "4xx"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "noValue": "No data / scrape failed" }
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx / upstream system error ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(proxy_requests_total{result=~\"system_error|no_capacity|rate_limited\"}[5m])) / clamp_min(sum(rate(proxy_requests_total[5m])), 1e-9)",
          "legendFormat": "system"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "noValue": "No data / scrape failed" }
      },
      "options": {}
    },
