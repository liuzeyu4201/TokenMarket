# TokenMarket local development environment template (SF01).
# Copy this file to `.env.local` and replace every placeholder with values
# appropriate for your local workstation. Never commit real credentials.

# Operational mode: local | test | prod. Omitting defaults to local.
MODE=local

# PostgreSQL connection used by api-service and billing-service for local
# development and migration integration checks.
DATABASE_URL=postgresql://app:replace-me@localhost:5432/tokenmarket

# Admin service does not own migrations in SF01; this URL is reserved for
# future read-only use and must remain empty or use the same safe placeholder.
ADMIN_DATABASE_URL=postgresql://app:replace-me@localhost:5432/tokenmarket

# Redis and Kafka endpoints are reserved for SF02 lifecycle implementation.
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092

# AI provider endpoints and keys are out of scope for SF01; keep placeholders.
AI_GATEWAY_URL=https://api.example.local
AI_GATEWAY_KEY=sk-replace-me

# Observability and secrets scanning (out of scope for SF01).
GRAFANA_ADMIN_PASSWORD=replace-me
